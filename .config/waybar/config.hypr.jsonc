{
  "layer": "top",
  "position": "top",
  "height": 25,
  "spacing": 4,
  "margin-top": 5,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/scatchpad"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "privacy",
    "mpd",
    "tray",
    "pulseaudio",
    "battery",
    "hyprland/language",
    "clock"
  ],
  "include": [
    "~/.config/waybar/modules/system.json",
    "~/.config/waybar/modules/hyprland.json",
    "~/.config/waybar/modules/mpd.json"
  ]
}