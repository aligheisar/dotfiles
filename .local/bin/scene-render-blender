#!/usr/bin/env python

import bpy
import sys

args = sys.argv
version = "v1"
ignored_scenes = []

if "--" in args:
    custom_args = args[args.index("--") + 1:]

    if custom_args:
        version = custom_args[0]

    if "--ignore" in custom_args:
        ignore_index = custom_args.index("--ignore") + 1
        ignored_scenes = custom_args[ignore_index:]

for scene in bpy.data.scenes:
    if scene.name in ignored_scenes:
        print(f"Skipping scene: {scene.name}")
        continue

    scene.render.filepath = f"//renders/{version}/{scene.name}/"

    print(f"Rendering scene: {scene.name}")
    print(f"Output: {scene.render.filepath}")

    bpy.ops.render.render(
        animation=True,
        scene=scene.name
    )

print("All scenes finished!")

