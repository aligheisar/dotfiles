#!/bin/bash

# Get the current mute state
mute_state=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q '\[MUTED\]' && echo "yes" || echo "no")

# If muted, just unmute and exit
if [ "$mute_state" = "yes" ]; then
		wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
    exit 0
fi

# Determine increment
case "$1" in
    extreme)
        increment="10%"
        ;;
    precise)
        increment="1%"
        ;;
    *)
        increment="5%"
        ;;
esac

wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${increment}+"
